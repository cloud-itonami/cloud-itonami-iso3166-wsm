[
#:culture{:id "wsm.dish.palusami", :name "Palusami", :country "WSM", :kind :dish, :summary "Samoan dish of taro leaves filled with coconut cream (often with beef and onions), wrapped and steamed -- a quintessential part of Samoan food culture prized for its rich use of coconut cream.", :url "https://en.wikipedia.org/wiki/L%C5%AB%CA%BBau_(food)", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "wsm.dish.oka-ia", :name "Oka i'a", :country "WSM", :kind :dish, :summary "Samoan raw-fish dish (a regional variant of 'ota 'ika) in which fish is briefly marinated in lemon or lime juice until the flesh surface turns opaque, then mixed with coconut milk.", :url "https://en.wikipedia.org/wiki/%27Ota_%27ika", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "wsm.dish.alaisa-faapopo", :name "Alaisa fa'apopo", :country "WSM", :kind :dish, :summary "Samoan coconut rice made by cooking white rice in coconut milk; the variant with added cocoa and orange leaves is called koko alaisa and is eaten as a snack or dessert.", :url "https://en.wikipedia.org/wiki/Coconut_rice", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "wsm.beverage.otai", :name "'Otai", :country "WSM", :kind :beverage, :summary "Samoan fruit-and-coconut drink documented by European colonists in the late 19th century; in Samoa the name 'otai refers specifically to the version made with vi (ambarella) fruit and coconut.", :url "https://en.wikipedia.org/wiki/%CA%BBotai", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "wsm.beverage.ava", :name "'Ava", :country "WSM", :kind :beverage, :summary "Samoan name for kava, drunk at all important gatherings and ceremonies; prepared by the 'aumaga, served in a polished coconut half called an ipu tau 'ava, with serving order following chiefly rank.", :url "https://en.wikipedia.org/wiki/Kava_culture", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "wsm.craft.pea", :name "Pe'a", :country "WSM", :kind :craft, :summary "Traditional male tattoo (tatau) of Samoa, extending from waist to knees, applied by master tattooists (tufuga ta tatau) with handmade tools of bone, turtle shell and wood; a mark of manhood and ancestral connection.", :url "https://en.wikipedia.org/wiki/Pe%CA%BBa", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "wsm.craft.siapo", :name "Siapo", :country "WSM", :kind :craft, :summary "Samoan bark cloth (tapa), traditionally used for clothing, burial shrouds, bed covers and ceremonial garments; made via the siapo 'elei rubbing method or the freehand siapo mamanu method, with Palauli village on Savai'i noted for high-quality production.", :url "https://en.wikipedia.org/wiki/Tapa_cloth", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "wsm.festival.teuila", :name "Teuila Festival", :country "WSM", :kind :festival, :summary "One of Samoa's largest cultural events; the Miss Samoa pageant has been held as its finale annually since 2000.", :url "https://en.wikipedia.org/wiki/Miss_Samoa", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "wsm.heritage.vailima", :name "Vailima", :country "WSM", :kind :heritage, :summary "Village on Upolu south of Apia, site of author Robert Louis Stevenson's final residence Villa Vailima, later used by German and New Zealand administrators before becoming the Robert Louis Stevenson Museum; Stevenson is buried atop nearby Mount Vaea.", :url "https://en.wikipedia.org/wiki/Vailima,_Samoa", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
]
